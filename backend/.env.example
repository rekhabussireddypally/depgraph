# CognoDB Cloud connection details.
# Get these from console.cognodb.com after creating a free (c0) instance.
# NEVER commit the real .env file -- it is gitignored.
NEO4J_URI=bolt+s://your-instance-id.databases.cognodb.cloud
NEO4J_USER=cognodb
NEO4J_PASSWORD=your-generated-password

# Comma-separated list of origins allowed to call this API (your frontend URL).
CORS_ORIGINS=http://localhost:5173
